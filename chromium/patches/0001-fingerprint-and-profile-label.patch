+    "lucida sans unicode", "malgun gothic", "marlett",
+    "microsoft himalaya", "microsoft jhenghei", "microsoft new tai lue",
+    "microsoft phagspa", "microsoft sans serif", "microsoft tai le",
+    "microsoft yahei", "microsoft yi baiti", "mingliu-extb",
+    "mingliu_hkscs-extb", "mongolian baiti", "ms gothic",
+    "ms pgothic",     "ms ui gothic",     "mv boli",
+    "myanmar text",   "nirmala text",     "nirmala ui",
+    "nsimsun",        "palatino linotype", "pmingliu-extb",
+    "sans serif collection", "segoe fluent icons", "segoe mdl2 assets",
+    "segoe print",    "segoe script",     "segoe ui",
+    "simsun",         "sitka",            "sylfaen",
+    "symbol",         "tahoma",           "times new roman",
+    "trebuchet ms",   "verdana",          "webdings",
+    "wingdings",      "yu gothic",
+};
+
+// With a fingerprint noise seed, every font that is not a Windows default is
+// hidden for about half of the profiles (decided per profile and family), so
+// the set of installed fonts no longer identifies the machine across profiles.
+bool IsFontHiddenByFingerprint(const AtomicString& family) {
+  const FingerprintConfig* fingerprint = FingerprintConfig::Get();
+  if (!fingerprint || family.empty()) {
+    return false;
+  }
+  const std::string name = base::ToLowerASCII(family.Utf8());
+  for (std::string_view default_font : kWindowsDefaultFonts) {
+    if (name == default_font ||
+        (name.starts_with(default_font) && name.size() > default_font.size() &&
+         name[default_font.size()] == ' ')) {
+      return false;
+    }
+  }
+  if (!fingerprint->font_allowlist.empty()) {
+    for (const std::string& allowed : fingerprint->font_allowlist) {
+      if (name == allowed) return false;
+    }
+    return true;
+  }
+  if (!fingerprint->noise_seed || !fingerprint->noise_fonts) return false;
+  uint64_t hash = 0xcbf29ce484222325ull ^ fingerprint->noise_seed;
+  for (char c : name) {
+    hash ^= static_cast<uint8_t>(c);
+    hash *= 0x00000100000001b3ull;
+  }
+  return (hash >> 32) % 2 == 0;
+}

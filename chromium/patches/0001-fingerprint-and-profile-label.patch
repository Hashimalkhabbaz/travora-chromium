+// a family also matches its styled variants ("segoe ui" -> "segoe ui light").
+constexpr std::string_view kWindowsDefaultFonts[] = {
+    "arial",          "bahnschrift",      "calibri",
+    "cambria",        "candara",          "cascadia code",
+    "cascadia mono",  "comic sans ms",    "consolas",

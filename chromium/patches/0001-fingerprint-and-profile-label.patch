+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/canvas_interventions/fingerprint_noise.h"
+
+#include <cstdint>
+
+#include "third_party/blink/public/common/fingerprint/fingerprint_config.h"
+#include "third_party/blink/public/common/fingerprinting_protection/noise_token.h"
+#include "third_party/blink/renderer/core/canvas_interventions/noise_hash.h"
+#include "third_party/blink/renderer/core/canvas_interventions/noise_helper.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/graphics/static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/graphics/unaccelerated_static_bitmap_image.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+
+namespace blink {
+
+namespace {
+
+// Canvases larger than this are not noised: fingerprinting canvases are small,
+// and noising every readback of a huge canvas (e.g. an image editor) is slow.
+constexpr int64_t kMaxNoisedPixels = 4096 * 4096;
+
+uint64_t Fnv1a(uint64_t hash, base::span<const uint8_t> bytes) {
+  for (uint8_t byte : bytes) {
+    hash ^= byte;
+    hash *= 0x00000100000001b3ull;
+  }
+  return hash;
+}
+
+// 0 when noise is disabled; otherwise seed mixed with the site of `context`.
+uint64_t NoiseTokenFor(ExecutionContext* context) {
+  const FingerprintConfig* fingerprint = FingerprintConfig::Get();
+  if (!fingerprint || !fingerprint->noise_seed || !context) {
+    return 0;
+  }
+  String site;
+  if (const SecurityOrigin* origin = context->GetSecurityOrigin()) {
+    site = origin->RegistrableDomain();
+    if (site.empty()) {
+      site = origin->Host();
+    }
+  }
+  std::string site_utf8 = site.Utf8();
+  uint64_t token = Fnv1a(0xcbf29ce484222325ull ^ fingerprint->noise_seed,
+                         base::as_byte_span(site_utf8));
+  return token ? token : 1;
+}
+
+}  // namespace
+
+scoped_refptr<StaticBitmapImage> MaybeNoiseCanvasSnapshot(
+    ExecutionContext* context,
+    scoped_refptr<StaticBitmapImage> image,
+    bool webgl) {
+  const FingerprintConfig* config = FingerprintConfig::Get();
+  if (!config || !(webgl ? config->noise_webgl : config->noise_canvas)) return image;
+  const uint64_t token = NoiseTokenFor(context);
+  if (!token || !image) {
+    return image;
+  }
+  const int64_t pixel_count =
+      static_cast<int64_t>(image->width()) * image->height();
+  if (pixel_count <= 0 || pixel_count > kMaxNoisedPixels) {
+    return image;
+  }
+
+  scoped_refptr<StaticBitmapImage> raster = image->MakeUnaccelerated();
+  if (!raster) {
+    return image;
+  }
+  sk_sp<SkImage> source = raster->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source) {
+    return image;
+  }
+
+  // Unpremultiplied RGBA so noise never produces invalid premultiplied values.
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(SkImageInfo::Make(
+          source->width(), source->height(), kRGBA_8888_SkColorType,
+          kUnpremul_SkAlphaType, source->refColorSpace()))) {
+    return image;
+  }
+  if (!source->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+
+  // SAFETY: the bitmap was allocated above with exactly width*height*4 bytes
+  // (kRGBA_8888, minimal row bytes).
+  base::span<uint8_t> pixels = UNSAFE_BUFFERS(base::span(
+      static_cast<uint8_t*>(bitmap.getPixels()), bitmap.computeByteSize()));
+  NoisePixels(NoiseHash(NoiseToken(token)), pixels, bitmap.width(),
+              bitmap.height());
+  bitmap.setImmutable();
+
+  return UnacceleratedStaticBitmapImage::Create(bitmap.asImage(),
+                                                image->Orientation());
+}
+
+void MaybeNoiseRgbaPixels(ExecutionContext* context,
+                          base::span<uint8_t> pixels,
+                          int width,
+                          int height) {
+  const FingerprintConfig* config = FingerprintConfig::Get();
+  if (!config || !config->noise_webgl) return;
+  const uint64_t token = NoiseTokenFor(context);
+  if (!token || width <= 0 || height <= 0 ||
+      static_cast<int64_t>(width) * height > kMaxNoisedPixels ||
+      pixels.size() != static_cast<size_t>(width) * height * 4) {
+    return;
+  }
+  NoisePixels(NoiseHash(NoiseToken(token)), pixels, width, height);
+}
+
+void MaybeNoiseAudioSamples(ExecutionContext* context,
+                            base::span<float> samples,
+                            unsigned channel) {
+  const FingerprintConfig* config = FingerprintConfig::Get();
+  if (!config || !config->noise_audio) return;
+  uint64_t state = NoiseTokenFor(context);
+  if (!state) {
+    return;
+  }
+  state ^= 0x9e3779b97f4a7c15ull * (channel + 1);
+  for (float& sample : samples) {
+    // xorshift64*: cheap deterministic sequence per (profile, site, channel).
+    state ^= state >> 12;
+    state ^= state << 25;
+    state ^= state >> 27;
+    const uint64_t random = state * 0x2545f4914f6cdd1dull;
+    // Uniform in [-1, 1) scaled to ~1e-6 relative: inaudible, but it changes
+    // the float values that audio fingerprints hash. Silence stays silent.
+    const double unit =
+        static_cast<double>(random >> 11) / static_cast<double>(1ull << 52) -
+        1.0;
+    sample = static_cast<float>(sample * (1.0 + unit * 1e-6));
+  }
+}
+
+}  // namespace blink

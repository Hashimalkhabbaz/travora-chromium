diff --git a/third_party/blink/common/fingerprint/fingerprint_config.cc b/third_party/blink/common/fingerprint/fingerprint_config.cc
new file mode 100644
index 0000000000..3e478f3cc2
--- /dev/null
+++ b/third_party/blink/common/fingerprint/fingerprint_config.cc
@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/fingerprint/fingerprint_config.h"
+
+#include <optional>
+#include <string>
+
+#include "base/base64.h"
+#include "base/command_line.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+
+namespace blink {
+
+namespace {
+
+void ReadString(const base::DictValue& dict,
+                std::string_view key,
+                std::string& out) {
+  if (const std::string* value = dict.FindString(key)) {
+    out = *value;
+  }
+}
+
+void ReadInt(const base::DictValue& dict, std::string_view key, int& out) {
+  if (std::optional<double> value = dict.FindDouble(key)) {
+    out = static_cast<int>(*value);
+  }
+}
+
+const FingerprintConfig* Parse() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kFingerprintDataSwitch)) {
+    return nullptr;
+  }
+
+  std::string json;
+  if (!base::Base64Decode(
+          command_line->GetSwitchValueASCII(kFingerprintDataSwitch), &json)) {
+    LOG(ERROR) << "--" << kFingerprintDataSwitch << " is not valid base64";
+    return nullptr;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    LOG(ERROR) << "--" << kFingerprintDataSwitch << " is not a JSON object";
+    return nullptr;
+  }
+
+  auto* config = new FingerprintConfig();  // Lives for the whole process.
+  ReadString(*root, "ua", config->user_agent);
+  ReadString(*root, "platform", config->navigator_platform);
+  ReadString(*root, "timezone", config->timezone);
+  ReadInt(*root, "hardwareConcurrency", config->hardware_concurrency);
+  if (std::optional<double> memory = root->FindDouble("deviceMemory")) {
+    config->device_memory = static_cast<float>(*memory);
+  }
+
+  if (const base::DictValue* ch = root->FindDict("ch")) {
+    ReadString(*ch, "platform", config->ch_platform);
+    ReadString(*ch, "platformVersion", config->ch_platform_version);
+    ReadString(*ch, "architecture", config->ch_architecture);
+    ReadString(*ch, "bitness", config->ch_bitness);
+    ReadString(*ch, "model", config->ch_model);
+  }
+  if (const base::DictValue* screen = root->FindDict("screen")) {
+    ReadInt(*screen, "width", config->screen_width);
+    ReadInt(*screen, "height", config->screen_height);
+    ReadInt(*screen, "availWidth", config->screen_avail_width);
+    ReadInt(*screen, "availHeight", config->screen_avail_height);
+    ReadInt(*screen, "colorDepth", config->screen_color_depth);
+  }
+  if (const base::DictValue* geo = root->FindDict("geo")) {
+    std::optional<double> lat = geo->FindDouble("lat");
+    std::optional<double> lon = geo->FindDouble("lon");
+    if (lat && lon && *lat >= -90 && *lat <= 90 && *lon >= -180 &&
+        *lon <= 180) {
+      config->has_geolocation = true;
+      config->latitude = *lat;
+      config->longitude = *lon;
+      config->accuracy = geo->FindDouble("accuracy").value_or(100);
+    }
+  }
+  if (const std::string* seed = root->FindString("noiseSeed")) {
+    if (!base::HexStringToUInt64(*seed, &config->noise_seed)) {
+      LOG(ERROR) << "Invalid noiseSeed in --" << kFingerprintDataSwitch;
+      config->noise_seed = 0;
+    }
+  }
+  if (const base::DictValue* webgl = root->FindDict("webgl")) {
+    ReadString(*webgl, "vendor", config->webgl_vendor);
+    ReadString(*webgl, "renderer", config->webgl_renderer);
+  }
+  if (const base::DictValue* noise = root->FindDict("noise")) {
+    config->noise_canvas = noise->FindBool("canvas").value_or(true);
+    config->noise_webgl = noise->FindBool("webgl").value_or(true);
+    config->noise_audio = noise->FindBool("audio").value_or(true);
+    config->noise_fonts = noise->FindBool("fonts").value_or(true);
+    config->noise_client_rects = noise->FindBool("clientRects").value_or(false);
+    config->noise_speech_voices = noise->FindBool("speechVoices").value_or(false);
+  }
+  if (const base::ListValue* fonts = root->FindList("fontAllowlist")) {
+    for (const auto& font : *fonts) {
+      if (font.is_string()) config->font_allowlist.push_back(font.GetString());
+    }
+  }
+  config->webrtc_disabled = root->FindBool("webrtcDisabled").value_or(false);
+  if (const base::DictValue* webgpu = root->FindDict("webgpu")) {
+    config->webgpu_disabled = webgpu->FindBool("disabled").value_or(false);
+    config->has_webgpu_metadata = webgpu->FindBool("custom").value_or(false);
+    ReadString(*webgpu, "vendor", config->webgpu_vendor);
+    ReadString(*webgpu, "architecture", config->webgpu_architecture);
+    ReadString(*webgpu, "device", config->webgpu_device);
+    ReadString(*webgpu, "description", config->webgpu_description);
+  }
+  return config;
+}
+
+}  // namespace
+
+// static
+const FingerprintConfig* FingerprintConfig::Get() {
+  static const FingerprintConfig* const config = Parse();
+  return config;
+}
+
+}  // namespace blink

diff --git a/third_party/blink/public/common/fingerprint/fingerprint_config.h b/third_party/blink/public/common/fingerprint/fingerprint_config.h
new file mode 100644
index 0000000000..a35e38a800
--- /dev/null
+++ b/third_party/blink/public/common/fingerprint/fingerprint_config.h
@@ -0,0 +1,95 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink {
+
+// Command-line switch carrying the fingerprint for this browser instance:
+// base64-encoded JSON (schema below). It is set on the browser process by the
+// profile manager and copied to every child process, so the browser (HTTP
+// headers, UA client hints) and renderers (navigator, screen, WebGL) agree.
+//
+// {
+//   "ua": "Mozilla/5.0 (...)",            navigator.userAgent + User-Agent header
+//   "platform": "Win32",                   navigator.platform
+//   "ch": { "platform": "Windows", "platformVersion": "19.0.0",
+//           "architecture": "x86", "bitness": "64", "model": "" },
+//   "hardwareConcurrency": 8,
+//   "deviceMemory": 8,
+//   "screen": { "width": 1920, "height": 1080, "availWidth": 1920,
+//               "availHeight": 1040, "colorDepth": 24 },
+//   "webgl": { "vendor": "Google Inc. (NVIDIA)", "renderer": "ANGLE (...)" },
+//   "timezone": "Europe/Rome",             IANA id, e.g. from the proxy's location
+//   "geo": { "lat": 45.47, "lon": 9.19, "accuracy": 80 },   navigator.geolocation
+//   "noiseSeed": "9f3c2a1b4d5e6f70"        hex uint64: canvas/WebGL/audio noise
+//                                          and per-profile font subset
+// }
+//
+// Every field is optional; absent fields keep the real value.
+inline constexpr char kFingerprintDataSwitch[] = "fingerprint-data";
+
+struct BLINK_COMMON_EXPORT FingerprintConfig {
+  // Returns the config of the current process, or nullptr when the switch is
+  // absent or invalid. Parsed once; thread-safe.
+  static const FingerprintConfig* Get();
+
+  std::string user_agent;
+  std::string navigator_platform;
+
+  std::string ch_platform;
+  std::string ch_platform_version;
+  std::string ch_architecture;
+  std::string ch_bitness;
+  std::string ch_model;
+
+  int hardware_concurrency = 0;
+  float device_memory = 0;
+
+  int screen_width = 0;
+  int screen_height = 0;
+  int screen_avail_width = 0;
+  int screen_avail_height = 0;
+  int screen_color_depth = 0;
+
+  std::string webgl_vendor;
+  std::string webgl_renderer;
+
+  std::string timezone;
+
+  bool has_geolocation = false;
+  double latitude = 0;
+  double longitude = 0;
+  double accuracy = 0;
+
+  // 0 = noise disabled.
+  uint64_t noise_seed = 0;
+  // Optional independent controls. Existing seed-only profiles retain their
+  // original canvas/WebGL/audio/font behavior; new surfaces are opt-in.
+  bool noise_canvas = true;
+  bool noise_webgl = true;
+  bool noise_audio = true;
+  bool noise_fonts = true;
+  bool noise_client_rects = false;
+  bool noise_speech_voices = false;
+  std::vector<std::string> font_allowlist;
+  bool webrtc_disabled = false;
+  bool webgpu_disabled = false;
+  bool has_webgpu_metadata = false;
+  std::string webgpu_vendor;
+  std::string webgpu_architecture;
+  std::string webgpu_device;
+  std::string webgpu_description;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_FINGERPRINT_FINGERPRINT_CONFIG_H_
